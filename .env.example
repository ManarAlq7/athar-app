# ————— Supabase —————
# من: Project Settings → API Keys
# القيمتان أدناه عامّتان بطبيعتهما وتظهران في المتصفح — الحماية عبر سياسات RLS.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ————— Anthropic —————
# ⚠️ لا يُوضع هنا ولا في أي متغيّر يبدأ بـ VITE_ — تلك تُحقن في حزمة المتصفح.
# يُضبط في Cloudflare فقط:
#   Pages → المشروع → Settings → Variables and Secrets → Add → نوع Secret
#   الاسم: ANTHROPIC_API_KEY
# محلياً للتجربة: ضعه في .dev.vars (مستثنى من git) بصيغة:
#   ANTHROPIC_API_KEY=sk-ant-...
